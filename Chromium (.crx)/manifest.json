{
  "manifest_version": 3,
  "name": "Edge Fluent Scrollbars",
  "description": "Restores Edge-style Fluent overlay scrollbars on web pages.",
  "version": "1.1.1",
  "minimum_chrome_version": "121",
  "homepage_url": "https://github.com/zhumengstarsea/modern-scroll",
  "icons": {
    "64": "images/icon.png",
    "128": "images/icon@2x.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "all_frames": true,
      "run_at": "document_start",
      "js": ["includes/edge_fluent_scrollbars.js"]
    }
  ]
}
